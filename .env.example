DATABASE_URL="file:./prisma/dev.db"
# Generate a long random value before any deployment. Never expose this to the browser.
SESSION_SECRET="replace-with-a-long-random-secret"
# A local-only development value. Set a unique value before sharing any test link.
ADMIN_PASSWORD="replace-with-a-unique-admin-password"
MAX_AUDIO_MB="200"
MAX_IMAGE_MB="10"
MAX_VIDEO_MB="100"
MAX_AUDIO_DURATION_SECONDS="1800"
# Optional server-only OpenAI-compatible AI provider. Leave blank for safe fallback mode.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
